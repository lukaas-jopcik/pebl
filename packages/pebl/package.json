{
  "name": "pebl",
  "version": "0.1.0",
  "description": "Local-only AI Task Receipts for Claude Code and Codex CLI, backed by evidence, not guesses.",
  "license": "Apache-2.0",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agent",
    "cli",
    "receipts",
    "verification"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukaas-jopcik/pebl.git",
    "directory": "packages/pebl"
  },
  "homepage": "https://github.com/lukaas-jopcik/pebl/tree/main/packages/pebl#readme",
  "bugs": {
    "url": "https://github.com/lukaas-jopcik/pebl/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pebl": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
